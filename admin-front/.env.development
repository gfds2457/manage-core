# 开发环境：直连独立 mock 后端项目 admin-mock-backend（Express + CORS，端口 3001）
VITE_API_BASE_URL=http://localhost:3001/api
# 开发环境：直连独立 AI 后端项目 admin-ai-backend（Express + MySQL + 大模型，端口 3000）
# 注意：admin-ai-backend 是 Node/Express 服务，不是 Python 项目，没有 uvicorn，
# 端口固定 3000，不要写成 8000，否则会报 net::ERR_CONNECTION_REFUSED
VITE_AI_API_BASE_URL=http://localhost:3000

# 知识库同步令牌（/kb/* 鉴权用），需与 admin-ai-backend 的 src/.env 中 KB_SYNC_TOKEN 一致。
# 属于凭据，不写在本文件里：本文件会入库。请放在同目录的 .env.development.local，
# 该文件被 .gitignore 的 *.local 规则忽略。未配置时前端不发鉴权头。
# VITE_KB_SYNC_TOKEN=
