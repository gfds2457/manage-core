{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cd admin-mock-backend && npm ci && npm run build"
  },
  "deploy": {
    "startCommand": "cd admin-mock-backend && node dist/index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
