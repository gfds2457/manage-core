# ============================================================
# admin-ai-backend 配置模板
#
# 使用方式：复制为同目录下的 src/.env 并填入真实值
#   cp src/.env.example src/.env
#
# 所有大模型 / Embedding 模型配置集中在此，代码内不得硬编码。
# 缺少必填项时服务启动会直接抛出明确错误并退出。
# ============================================================

# ---------- 大模型（对话/改写/摘要） ----------
OPENAI_API_KEY="<你的 API Key>"
OPENAI_API_BASE_URL="https://<你的网关地址>/compatible-mode/v1"
OPENAI_API_MODEL_NAME="qwen3.8-flash"

# ---------- 图片生成模型（可选，缺省回落到上面的 base url） ----------
IMAGE_API_BASE_URL="https://<你的网关地址>/api/v1"
# 下面两项的代码默认值只适用于当前接入的网关（阿里云百炼 wan 系列）
# 换网关时必须显式配置，否则会静默请求到旧网关上（启动期会校验格式，但校验不出「网关换了」）
IMAGE_MODEL_NAME="qwen-image-3.0"
IMAGE_GENERATE_PATH="/services/aigc/multimodal-generation/generation"
# 图片生成参数
IMAGE_SIZE="2K"
IMAGE_N="1"
IMAGE_WATERMARK="false"
IMAGE_THINKING_MODE="true"

# ---------- 服务端口 ----------
# 前端 .env 的 VITE_AI_API_BASE_URL 必须指向同一端口，
# 否则页面加载时健康检查会报 net::ERR_CONNECTION_REFUSED
PORT="3000"

# ---------- Embedding 模型 ----------
EMBEDDING_MODEL="qwen3.7-text-embedding"
# 必须与向量库表结构一致，改小/改大都会触发全量重建
EMBEDDING_DIMENSIONS="1024"

# ---------- LanceDB 向量库 ----------
# 相对路径以本项目根目录为基准解析
LANCEDB_PATH="./src/data/lancedb"
LANCEDB_TABLE="knowledge_chunks"

# ---------- RAG 检索参数 ----------
RAG_TOP_K="5"
# 余弦相似度下限，低于该值视为未命中（0~1）
RAG_SCORE_THRESHOLD="0.35"
RAG_CHUNK_SIZE="200"
RAG_CHUNK_OVERLAP="40"
RAG_EMBED_BATCH_SIZE="10"
RAG_TIMEOUT_MS="30000"
# 是否开启检索前的 query 改写
RAG_QUERY_REWRITE="true"
RAG_RETRY_TIMES="2"
RAG_RETRY_DELAY_MS="500"

# ---------- 知识库增量更新接口鉴权 ----------
# 业务侧调用 /kb/* 接口时通过 x-kb-token 或 Authorization: Bearer 携带
KB_SYNC_TOKEN="<自定义同步令牌>"
KB_MAX_CHUNKS_PER_DOC="20"
# 后台增量更新队列上限，打满后 /kb/* 返回 503，由业务侧重试
KB_QUEUE_MAX_SIZE="1000"

# LanceDB 增量清单文件位置（默认与 LanceDB 数据目录同级）
# KB_MANIFEST_PATH="./src/data/kb-manifest.json"

# ---------- 文档目录（可选，支持绝对路径） ----------
# 知识库源文档目录
# DOC_DIR="doc"
# 提示词模板目录（需包含 context.md）
# CONTEXT_DIR="context"

# ---------- 数据库配置 ----------
DB_HOST="<数据库主机名>"
DB_PORT="<数据库端口>"
DB_USER="<数据库用户名>"
DB_PASSWORD="<数据库密码>"
DB_NAME="<数据库名称>"